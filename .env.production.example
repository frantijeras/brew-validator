# BrewIdea — variables de producción (VPS)
# Copia este archivo a .env.production en el VPS y rellena los valores.
# .env.production NO se sube al repo (está en .gitignore).

# Base de datos (Neon PostgreSQL) — la MISMA que usabas en Vercel.
DATABASE_URL="postgresql://..."

# NextAuth — la URL pública real ya con HTTPS.
NEXTAUTH_URL="https://brewidea.duckdns.org"
NEXTAUTH_SECRET="genera-un-secreto-aleatorio"

# Bridge de OpenClaw. Como la app corre en el MISMO VPS que el bridge,
# se le habla por localhost del host (ver nota de red en deploy/README.md).
BRIDGE_API_URL="http://host.docker.internal:9090"
OPENCODE_API_KEY=""
BRIDGE_SECRET=""

# Cron del reaper: define un secreto y úsalo en el crontab del VPS.
CRON_SECRET="genera-otro-secreto-aleatorio"
