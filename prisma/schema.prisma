generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id              String   @id @default(cuid())
  title           String
  description     String
  targetUser      String
  monetization    String
  status          String   @default("DRAFT")
  validationStatus String  @default("PENDING")
  verdict         String?
  score           Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs    Job[]
  reports Report[]
}

model Job {
  id         String    @id @default(cuid())
  ideaId     String
  idea       Idea      @relation(fields: [ideaId], references: [id])
  agentName  String
  status     String    @default("PENDING")
  input      String?
  output     String?
  error      String?
  cost       Float     @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Report {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id])
  agentName  String
  title      String
  content    String
  verdict    String?
  scorecard  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
