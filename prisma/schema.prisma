generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo (Windows/Mac) y el binario de Debian para la
  // imagen Docker del VPS (node:*-slim usa openssl 3.0).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Demo multiusuario: estado, procedencia e invitación ──
  status      String    @default("active") // "active" | "suspended"
  invitedById String?
  invitedAt   DateTime?

  // ── Consentimiento (gate del primer login) ──
  termsAcceptedAt  DateTime?
  termsVersion     String?
  consentIp        String?
  consentUserAgent String?

  // ── Cuotas y permisos por usuario (editables por el admin) ──
  maxIdeas          Int     @default(3)
  maxProjects       Int     @default(1)
  phaseUndosAllowed Int     @default(1)
  canAccessSkills   Boolean @default(false)
  canAccessHandoff  Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  settings      Setting[]
  ideas         Idea[]
  notifications Notification[]
}

/// Invitaciones que el admin envía por email. El invitado abre /invite/{token},
/// crea su contraseña y se le crea la cuenta (con las cuotas por defecto).
model Invitation {
  id             String    @id @default(cuid())
  email          String
  token          String    @unique
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedById    String?
  acceptedUserId String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  @@index([email])
  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id               String        @id @default(cuid())
  title            String
  description      String
  problem          String?
  valueProposition String?
  targetUser       String
  monetization     String
  status           IdeaStatus    @default(DRAFT)
  validationStatus String        @default("PENDING")
  verdict          String?
  score            Float?
  businessModel    String?
  originalIdea     String?
  metadata         Json?
  isArchived       Boolean       @default(false)
  userId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs             Job[]
  project          Project?
  reports          Report[]

  @@index([userId])
}

model Job {
  id         String    @id @default(cuid())
  ideaId     String
  agentName  String
  status     String    @default("PENDING")
  input      String?
  output     String?
  error      String?
  cost       Float     @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  idea       Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Report {
  id            String       @id @default(cuid())
  ideaId        String
  agentName     String
  title         String
  content       String
  verdict       String?
  scorecard     String?
  score         Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  idea          Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Project {
  id              String         @id @default(cuid())
  ideaId          String         @unique
  name            String
  description     String?
  memory          Json?
  skills          Json?
  handoffReady    Boolean        @default(false)
  generatedSkills Json?
  rollbacksUsed   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  idea            Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  phases          ProjectPhase[]
}

model ProjectPhase {
  id              String    @id @default(cuid())
  projectId       String
  type            PhaseType
  label           String
  description     String?
  status          String    @default("LOCKED")
  sortOrder       Int       @default(0)
  artifacts       Json?
  questions       Json?
  answers         Json?
  subStep         String?
  subStepArtifact Json?
  subStepChoice   String?
  subStepOrder    Int?
  subStepHistory  Json?
  lastError       Json?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Setting {
  id     String @id @default(cuid())
  key    String
  value  Json
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
}

/// Historial de errores/eventos del Bridge (Puente con las APIs de IA).
/// Una fila por evento relevante (sobre todo fallos). Sin claves foráneas
/// duras a propósito: son referencias sueltas (jobId/projectId/phaseId/ideaId)
/// para no acoplar el log al ciclo de vida de esas entidades ni arriesgar
/// borrados en cascada. Se consulta por proyecto en el panel "Historial de Errores".
model BridgeLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  level            String   @default("error") // "error" | "warning" | "info"
  // Referencias sueltas al contexto del evento
  jobId            String?
  ideaId           String?
  projectId        String?
  phaseId          String?
  agentName        String?
  // Clasificación y detalle del error
  errorType        String? // categoría estable (ver lib/phase-errors.ts ErrorCategory)
  errorMessage     String? // mensaje crudo del proveedor/bridge
  httpStatus       Int? // status HTTP del proveedor de IA, si lo hubo
  retryCount       Int? // nº de reintentos que hizo el bridge antes de rendirse
  resolutionAction String? // qué hizo el sistema (retry, fallback, reset_to_available...)
  // Telemetría técnica (debugging)
  model            String?
  provider         String?
  tokensIn         Int?
  tokensOut        Int?
  latencyMs        Int?
  schemaVersion    String? // versión del esquema esperado (evolución futura)

  @@index([createdAt])
  @@index([projectId])
  @@index([jobId])
}

/// Notificación in-app para el usuario. La usa la capa 4 del feedback del
/// Bridge (Puente con las APIs de IA): ante un error crítico (3+ reintentos
/// fallidos) se crea una fila aquí y la campanita del dashboard la muestra.
/// Sin clave foránea dura a Project/Phase (referencias sueltas) para no
/// acoplar la notificación al ciclo de vida de esas entidades.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  phaseId   String?
  level     String   @default("error") // "error" | "warning" | "info"
  title     String
  body      String
  errorType String? // categoría estable (ver lib/phase-errors.ts ErrorCategory)
  actionUrl String? // enlace recomendado de acción (p. ej. a la fase afectada)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum IdeaStatus {
  DRAFT
  GENERATING
  VALIDATING
  REFINING
  COMPLETED
  POLISHING
  FAILED
}

enum PhaseType {
  IDENTITY
  ANALYSIS
  CONTENT
  BUSINESS
  EXECUTION
}
