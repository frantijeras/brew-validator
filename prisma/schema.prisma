generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  settings      Setting[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id               String        @id @default(cuid())
  title            String
  description      String
  problem          String?
  valueProposition String?
  targetUser       String
  monetization     String
  status           IdeaStatus    @default(DRAFT)
  validationStatus String        @default("PENDING")
  verdict          String?
  score            Float?
  businessModel    String?
  originalIdea     String?
  metadata         Json?
  isArchived       Boolean       @default(false)
  isFavorite       Boolean       @default(false)
  currentVersionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  currentVersion   IdeaVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         IdeaVersion[]
  jobs             Job[]
  project          Project?
  reports          Report[]
}

model Job {
  id         String    @id @default(cuid())
  ideaId     String
  agentName  String
  status     String    @default("PENDING")
  input      String?
  output     String?
  error      String?
  cost       Float     @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  idea       Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Report {
  id            String       @id @default(cuid())
  ideaId        String
  ideaVersionId String?
  agentName     String
  title         String
  content       String
  verdict       String?
  scorecard     String?
  score         Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  idea          Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaVersion   IdeaVersion? @relation(fields: [ideaVersionId], references: [id])
}

model IdeaVersion {
  id               String   @id @default(cuid())
  ideaId           String
  title            String
  description      String
  problem          String?
  valueProposition String?
  targetUser       String
  monetization     String
  phase            String   @default("v0")
  score            Float?
  verdict          String?
  reportsSnapshot  Json?
  createdAt        DateTime @default(now())
  currentOf        Idea[]   @relation("CurrentVersion")
  idea             Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  reports          Report[]
}

model Project {
  id              String         @id @default(cuid())
  ideaId          String         @unique
  name            String
  description     String?
  status          String         @default("ACTIVE")
  memory          Json?
  skills          Json?
  handoffReady    Boolean        @default(false)
  generatedSkills Json?
  buyerPersona    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  idea            Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  phases          ProjectPhase[]
}

model ProjectPhase {
  id              String    @id @default(cuid())
  projectId       String
  type            PhaseType
  label           String
  description     String?
  status          String    @default("LOCKED")
  sortOrder       Int       @default(0)
  artifacts       Json?
  questions       Json?
  subStep         String?
  subStepArtifact Json?
  subStepChoice   String?
  subStepOrder    Int?
  lastError       Json?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Setting {
  id     String @id @default(cuid())
  key    String
  value  Json
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
}

enum IdeaStatus {
  DRAFT
  GENERATING
  VALIDATING
  REFINING
  COMPLETED
  POLISHING
  FAILED
}

enum PhaseType {
  IDENTITY
  ANALYSIS
  CONTENT
  BUSINESS
  EXECUTION
}
