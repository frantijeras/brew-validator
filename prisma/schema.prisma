generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdeaStatus {
  DRAFT
  GENERATING
  VALIDATING
  REFINING
  COMPLETED
  POLISHING
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  settings      Setting[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id               String     @id @default(cuid())
  title            String
  description      String
  problem          String?
  valueProposition String?
  targetUser       String
  monetization     String
  status           IdeaStatus @default(DRAFT)
  validationStatus String     @default("PENDING")
  verdict          String?
  score            Float?
  businessModel    String? // SaaS, Marketplace, E-commerce, App móvil, Plataforma, Negocio local, Servicios, Contenido/Media, Hardware/IoT, API/Infra, Impacto social, Otro
  originalIdea     String?
  metadata         Json?
  isArchived       Boolean    @default(false)
  isFavorite       Boolean    @default(false)
  currentVersionId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  currentVersion IdeaVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  jobs           Job[]
  reports        Report[]
  versions       IdeaVersion[]
  project        Project?
}

model Job {
  id         String    @id @default(cuid())
  ideaId     String
  idea       Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  agentName  String
  status     String    @default("PENDING")
  input      String?
  output     String?
  error      String?
  cost       Float     @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Report {
  id            String       @id @default(cuid())
  ideaId        String
  idea          Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaVersionId String?
  ideaVersion   IdeaVersion? @relation(fields: [ideaVersionId], references: [id], onDelete: SetNull)
  agentName     String
  title         String
  content       String
  verdict       String?
  scorecard     String?
  score         Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model IdeaVersion {
  id               String   @id @default(cuid())
  ideaId           String
  idea             Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  title            String
  description      String
  problem          String?
  valueProposition String?
  targetUser       String
  monetization     String
  phase            String   @default("v0")
  score            Float?
  verdict          String?
  reportsSnapshot  Json?
  createdAt        DateTime @default(now())

  currentOf Idea[]   @relation("CurrentVersion")
  reports   Report[]
}

model Project {
  id          String   @id @default(cuid())
  ideaId      String   @unique
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases ProjectPhase[]
}

enum PhaseType {
  IDENTITY
  ANALYSIS
  CONTENT
  DEVELOPMENT
  DOSSIER
}

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        PhaseType
  label       String
  description String?
  status      String    @default("LOCKED") // LOCKED, AVAILABLE, COMPLETED
  sortOrder   Int       @default(0)
  artifacts   Json?     // Array de { title, content, type }
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  id     String @id @default(cuid())
  key    String
  value  Json
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
}
