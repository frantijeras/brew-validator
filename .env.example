# BrewIdea — Environment Variables

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# OpenClaw Bridge — URL del daemon del bridge para configurar modelos de agentes
# (usado por settings/actions.ts y settings/agent-models). Por defecto 127.0.0.1:9090.
BRIDGE_API_URL="http://127.0.0.1:9090"

# API key para listar los modelos disponibles del bridge (settings/available-models).
OPENCODE_API_KEY=""

# Optional shared secret for bridge-facing endpoints (webhooks, jobs/pending).
# Leave empty to keep them open (current behaviour). When set, the bridge MUST
# send `Authorization: Bearer <BRIDGE_SECRET>` on every call. Set the SAME value
# here and in the bridge daemon to enable authentication without downtime.
BRIDGE_SECRET=""

# VPS / Bridge daemon — solo para scripts de mantenimiento local (NO subir al repo).
# Guardar en .env.local (ya está en .gitignore).
# VPS_HOST="46.225.80.127"
# VPS_USER="root"
# VPS_PASSWORD="..."
